# ==============================================================================
# clipsai — Variables de entorno (copiar a `.env` y completar los valores reales)
# ------------------------------------------------------------------------------
# NOTE: NUNCA commitear valores reales de aquí. Los secrets deben rotarse
# y guardarse solo en .env local o en el gestor de secretos del despliegue.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# PostgreSQL (Issue 1 — infraestructura)
# ------------------------------------------------------------------------------
POSTGRES_USER=clipsai
POSTGRES_PASSWORD=
POSTGRES_DB=clipsai
POSTGRES_PORT=5432
POSTGRES_TZ=UTC

# ------------------------------------------------------------------------------
# Backend FastAPI (Issue 3 — autenticacion)
# ------------------------------------------------------------------------------
# URL de conexion a Postgres. En docker-compose el host es `db`.
DATABASE_URL=
# Configurar con la contraseña anterior antes de desplegar, por ejemplo:
# postgresql+psycopg2://clipsai:<POSTGRES_PASSWORD>@db:5432/clipsai

# Generar una contraseña única de Postgres y un JWT_SECRET con `openssl rand -hex 32`.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

APP_ENV=production

# Obligatoria en produccion para cifrar tokens OAuth con AESGCM (clave de 32 bytes).
VAULT_KEY=

# ------------------------------------------------------------------------------
# Motor de clipsai — proveedores de IA
# ------------------------------------------------------------------------------
# Completar solo en el gestor de secretos si se habilita el proveedor.
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-5

# Opcional: API estilo OpenAI / OpenRouter / DeepSeek
# Si usas OpenAI directamente:
OPENAI_API_KEY=
# Si usas OpenRouter (proxy multi-modelo, soporta Claude/GPT):
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# Si usas DeepSeek directamente:
DEEPSEEK_API_KEY=

# Configuracion de la API DeepSeek (opcional)
API_ENDPOINT=https://api.deepseek.com/v1/chat/completions
MODEL=deepseek-chat

# RunPod Serverless + R2 para procesar video fuera del backend web.
# Se delega únicamente cuando RUNPOD_API_KEY y RUNPOD_ENDPOINT_ID tienen valor.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
AWS_REGION=auto
BUCKET_NAME=clipsai-videos

# ------------------------------------------------------------------------------
# Publicación a redes (Issue 12)
# ------------------------------------------------------------------------------
# Webhook genérico para automatizar publicación (Zapier/Make/n8n). Si vacío, se simula.
PUBLISH_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# OAuth 2.0 — Google / YouTube Data API v3
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.clipsai.xyz/auth/social/youtube/callback
# Los scopes se definen en el servicio: youtube.readonly y youtube.upload.

# ------------------------------------------------------------------------------
# OAuth 2.0 — Instagram Graph API (Meta)
# ------------------------------------------------------------------------------
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://api.clipsai.xyz/auth/social/instagram/callback

# ------------------------------------------------------------------------------
# OAuth 2.0 — TikTok for Developers
# ------------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.clipsai.xyz/auth/social/tiktok/callback
# El servicio requiere user.info.basic, video.upload y video.publish.
TIKTOK_SCOPES=user.info.basic,video.upload,video.publish

# ------------------------------------------------------------------------------
# Dominios públicos de producción (deben servir HTTPS válido)
# ------------------------------------------------------------------------------
PUBLIC_BACKEND_URL=https://api.clipsai.xyz
BACKEND_URL=https://api.clipsai.xyz
API_BASE_URL=https://api.clipsai.xyz
VITE_API_URL=https://api.clipsai.xyz
FRONTEND_URL=https://clipsai.xyz
FRONTEND_REDIRECT_URL=https://clipsai.xyz
PRIVACY_POLICY_URL=https://clipsai.xyz/politica-de-privacidad
TERMS_OF_SERVICE_URL=https://clipsai.xyz/terminos-y-condiciones
DATA_DELETION_URL=https://clipsai.xyz/eliminacion-de-datos
# Scopes solicitados por los servicios (no usar estos comentarios como scope override):
# Google/YouTube: youtube.readonly youtube.upload
# Meta/Instagram: instagram_basic, instagram_content_publish, pages_show_list,
#                 pages_read_engagement, business_management
# TikTok: user.info.basic, video.upload, video.publish
# Redirect URIs oficiales para paneles de desarrolladores:
# Google/YouTube: https://api.clipsai.xyz/auth/social/youtube/callback
# Meta/Instagram: https://api.clipsai.xyz/auth/social/instagram/callback
# TikTok: https://api.clipsai.xyz/auth/social/tiktok/callback

# ------------------------------------------------------------------------------
# Hardening HTTP (ASH)
# ------------------------------------------------------------------------------
# Orígenes CORS extra permitidos (regex). Por defecto solo *.clipsai.xyz.
# Para previews de Vercel o túneles ngrok, agregarlos explícitamente acá.
CORS_ORIGIN_REGEX=https://.*\.clipsai\.xyz
# Hosts permitidos por TrustedHost (coma-separados). En production, lista explícita.
ALLOWED_HOSTS=api.clipsai.xyz,clipsai.xyz,clipsai-backend.onrender.com,localhost,127.0.0.1,testserver
# Rate limit global por IP/minuto (default 120 en production, 5000 en desarrollo).
SECURITY_RATE_LIMIT=120
# Clave HMAC para URLs firmadas de clips. Si está vacía, usa JWT_SECRET.
STORAGE_SIGN_KEY=
# TTL de las URLs firmadas de clips (segundos).
MEDIA_URL_TTL_SECONDS=3600

# Túnel opcional para el servicio ngrok del docker-compose (no es el dominio de OAuth).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=api.clipsai.xyz

# ------------------------------------------------------------------------------
# Motor de clipsai — proveedores de IA (deepseek base_url)
# ------------------------------------------------------------------------------
# Si usas la API de DeepSeek directamente, el endpoint base:
# API_ENDPOINT=https://api.deepseek.com/v1/chat/completions
# MODEL=deepseek-chat
