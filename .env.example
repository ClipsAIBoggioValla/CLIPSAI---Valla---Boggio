# ==============================================================================
# clipsai — Variables de entorno (ejemplo)
# Copiar a `.env` (no versionado) y completar los valores reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL (Issue 1 — infraestructura)
# ------------------------------------------------------------------------------
POSTGRES_USER=clipsai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=clipsai
POSTGRES_PORT=5432
POSTGRES_TZ=UTC

# ------------------------------------------------------------------------------
# Motor de clipsai — proveedores de IA
# (Se completa en issues posteriores; se dejan aqui para centralizar la config)
# ------------------------------------------------------------------------------
# Clave de Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Opcional: API estilo OpenAI (DeepSeek) de respaldo
# OPENAI_API_KEY=
# MODEL=deepseek-chat
