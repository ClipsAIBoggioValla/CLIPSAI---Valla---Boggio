# ==============================================================================
# clipsai — Variables de entorno (ejemplo)
# Copiar a `.env` (no versionado) y completar los valores reales.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL (Issue 1 — infraestructura)
# ------------------------------------------------------------------------------
POSTGRES_USER=clipsai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=clipsai
POSTGRES_PORT=5432
POSTGRES_TZ=UTC

# ------------------------------------------------------------------------------
# Backend FastAPI (Issue 3 — autenticacion)
# ------------------------------------------------------------------------------
# URL de conexion a Postgres. Dentro de docker-compose el host es `db`.
# Para correr FastAPI fuera de compose apuntando al Postgres dockerizado usar `localhost`.
DATABASE_URL=postgresql+psycopg2://clipsai:changeme@db:5432/clipsai

# Secreto para firmar los JWT. Generar con: `openssl rand -hex 32`
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-minimo-16-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

APP_ENV=development

# ------------------------------------------------------------------------------
# Motor de clipsai — proveedores de IA
# (Se completa en issues posteriores; se dejan aqui para centralizar la config)
# ------------------------------------------------------------------------------
# Clave de Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Opcional: API estilo OpenAI (DeepSeek) de respaldo
# OPENAI_API_KEY=
# MODEL=deepseek-chat
