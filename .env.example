# ==============================================================================
# clipsai — Variables de entorno (copiar a `.env` y completar los valores reales)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# PostgreSQL (Issue 1 — infraestructura)
# ------------------------------------------------------------------------------
POSTGRES_USER=clipsai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=clipsai
POSTGRES_PORT=5432
POSTGRES_TZ=UTC

# ------------------------------------------------------------------------------
# Backend FastAPI (Issue 3 — autenticacion)
# ------------------------------------------------------------------------------
# URL de conexion a Postgres. En docker-compose el host es `db`.
DATABASE_URL=postgresql+psycopg2://clipsai:changeme@db:5432/clipsai

# Secreto para firmar los JWT. Generar con: `openssl rand -hex 32`
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-minimo-16-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

APP_ENV=development

# ------------------------------------------------------------------------------
# Motor de clipsai — proveedores de IA
# ------------------------------------------------------------------------------
# Clave de Anthropic (Claude) - https://console.anthropic.com/
# Generar en: https://console.anthropic.com/
ANTHROPIC_API_KEY=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

ANTHROPIC_MODEL=claude-sonnet-5

# Opcional: API estilo OpenAI (DeepSeek) — requiere OPENAI_API_KEY o DEEPSEEK_API_KEY
# Generar en: https://deepseek.com/ o proveedores compatibles
# Si usas OpenAI directamente, pon tu key aquí:
OPENAI_API_KEY=tu-api-key-de-openai-o-deepseek
# Si usas DeepSeek directamente (con base_url personalizado), pon tu key aquí:
DEEPSEEK_API_KEY=tu-api-key-deepseek

# Configuracion de la API DeepSeek (opcional)
# URL base para la API de DeepSeek (usado si MODEL=deepseek-chat)
API_ENDPOINT=https://api.deepseek.com/v1/chat/completions
MODEL=deepseek-chat

APP_ENV=development

# ------------------------------------------------------------------------------
# Motor de clipsai — proveedores de IA (deepseek base_url)
# ------------------------------------------------------------------------------
# Si usas la API de DeepSeek directamente, el endpoint base:
# API_ENDPOINT=https://api.deepseek.com/v1/chat/completions
# MODEL=deepseek-chat