# ==============================================================================
# clipsai — Variables de entorno (copiar a `.env` y completar los valores reales)
# ------------------------------------------------------------------------------
# NOTE: NUNCA commitear valores reales de aquí. Los secrets deben rotarse
# y guardarse solo en .env local o en el gestor de secretos del despliegue.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# PostgreSQL (Issue 1 — infraestructura)
# ------------------------------------------------------------------------------
POSTGRES_USER=clipsai
POSTGRES_PASSWORD=changeme_placeholder_must_change
POSTGRES_DB=clipsai
POSTGRES_PORT=5432
POSTGRES_TZ=UTC

# ------------------------------------------------------------------------------
# Backend FastAPI (Issue 3 — autenticacion)
# ------------------------------------------------------------------------------
# URL de conexion a Postgres. En docker-compose el host es `db`.
DATABASE_URL=postgresql+psycopg2://clipsai:changeme_placeholder_must_change@db:5432/clipsai

# Secreto para firmar los JWT. Generar con: `openssl rand -hex 32`
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-minimo-16-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

APP_ENV=development

# ------------------------------------------------------------------------------
# Motor de clipsai — proveedores de IA
# ------------------------------------------------------------------------------
# Clave de Anthropic (Claude) - https://console.anthropic.com/
# Generar en: https://console.anthropic.com/
# Placeholder — NUNCA commitear keys reales. Ver Issue 13.
ANTHROPIC_API_KEY=ANTHROPIC_API_KEY_colocar_aqui

ANTHROPIC_MODEL=claude-sonnet-5

# Opcional: API estilo OpenAI / OpenRouter / DeepSeek
# Si usas OpenAI directamente:
OPENAI_API_KEY=tu-api-key-de-openai
# Si usas OpenRouter (proxy multi-modelo, soporta Claude/GPT):
OPENROUTER_API_KEY=tu-api-key-openrouter
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# Si usas DeepSeek directamente:
DEEPSEEK_API_KEY=tu-api-key-deepseek

# Configuracion de la API DeepSeek (opcional)
API_ENDPOINT=https://api.deepseek.com/v1/chat/completions
MODEL=deepseek-chat

APP_ENV=development

# ------------------------------------------------------------------------------
# Publicación a redes (Issue 12)
# ------------------------------------------------------------------------------
# Webhook genérico para automatizar publicación (Zapier/Make/n8n). Si vacío, se simula.
PUBLISH_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# Motor de clipsai — proveedores de IA (deepseek base_url)
# ------------------------------------------------------------------------------
# Si usas la API de DeepSeek directamente, el endpoint base:
# API_ENDPOINT=https://api.deepseek.com/v1/chat/completions
# MODEL=deepseek-chat