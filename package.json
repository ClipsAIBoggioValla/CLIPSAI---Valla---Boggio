{
  "name": "clipsai-root",
  "version": "1.0.0",
  "private": true,
  "description": "Orquestación unificada ClipsAI — stack único FastAPI + React (db, backend, frontend) + ngrok",
  "scripts": {
    "dev": "concurrently --kill-others --names \"REACT,NGROK\" \"npm:dev:react\" \"npm:dev:ngrok\"",
    "dev:full": "docker compose up -d --build && npm run dev",
    "dev:docker": "docker compose up -d --build",
    "dev:docker:logs": "docker compose logs -f",
    "dev:react": "npm --prefix frontend_react run dev -- --host 0.0.0.0 --port 3000",
    "dev:ngrok": "ngrok http 8000 --domain=decorator-excretory-satin.ngrok-free.dev",
    "dev:up": "docker compose up -d db backend_fastapi",
    "dev:down": "docker compose down",
    "dev:ps": "docker compose ps",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "frontend_common",
    "frontend_react"
  ]
}
